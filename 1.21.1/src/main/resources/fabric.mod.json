{
  "schemaVersion": 1,
  "id": "horrormod",
  "version": "${version}",
  "name": "Horror Mod",
  "description": "A survival-horror experience: The Lurker, The Watcher, The Hollow, the Ashwood Forest, Cursed Ruins, and a full sanity system.",
  "authors": [
    "Your Name"
  ],
  "contact": {
    "sources": "https://github.com/your-username/horrormod"
  },
  "license": "MIT",
  "icon": "assets/horrormod/icon.png",

  "environment": "*",

  "entrypoints": {
    "main":   ["com.example.horrormod.HorrorMod"],
    "client": ["com.example.horrormod.HorrorModClient"]
  },

  "mixins": [
    "horrormod.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api":   "*",
    "minecraft":    "~${minecraft_version}"
  }
}
